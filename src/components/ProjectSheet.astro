---
import { layerNames, type Project } from '../data/projects';
import FlowFigure from './FlowFigure.astro';
import StackMark from './StackMark.astro';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const layer = layerNames[p.layer];
const lines = p.nameLines ?? [p.name];
---

<article class="project" id={p.slug} data-project-layer={p.layer} aria-labelledby={`${p.slug}-title`}>
  <div class="project__meta">
    <p class="label label--accent">Fig. {p.fig} · {p.category}</p>
    <p class="project__layer label label--muted">
      <StackMark lit={p.layer} />
      Lives in {layer.code} / {layer.name}
    </p>
  </div>

  <h3 class="project__name display" id={`${p.slug}-title`}>
    <a href={`/projects/${p.slug}`}>
      {lines.map((line, i) => (i < lines.length - 1 ? <>{line}<br /></> : line))}
    </a>
  </h3>

  <p class="project__tagline">{p.tagline}</p>
  <p class="project__summary">{p.summary}</p>
  <p class="project__role"><span class="label label--muted">My part</span> {p.role}.</p>
  <p class="project__stack mono">
    {p.stack.join(' / ')}{p.status && <> · {p.status}</>}
  </p>

  <div class="btn-row">
    <a class="btn btn--solid" href={`/projects/${p.slug}`}>Read the case study →</a>
    {
      p.live && (
        <a class="btn btn--line" href={p.live} rel="noopener">
          Live app ↗
        </a>
      )
    }
  </div>

  <div class="project__figure">
    <FlowFigure drawing={p.drawing} />
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 56px 0;
    border-bottom: var(--line) solid var(--ink);
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .project__layer {
    display: none;
    align-items: center;
    gap: 10px;
  }

  .project__name {
    font-stretch: 118%;
    font-size: clamp(38px, 4.6vw, 68px);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  .project__name a {
    text-decoration: none;
  }

  .project__tagline {
    font-size: 21px;
    line-height: 1.4;
    font-weight: 500;
    max-width: 40ch;
  }

  .project__summary,
  .project__role {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .project__role .label {
    margin-right: 6px;
    font-size: 11px;
  }

  .project__stack {
    font-size: 13px;
    color: var(--muted);
  }

  .project__figure {
    margin-top: 12px;
  }

  /* On narrow screens the big stack isn't beside the work, so each
     project carries a small one with its own layer lit. */
  @media (max-width: 899px) {
    .project__layer {
      display: flex;
    }
  }
</style>
